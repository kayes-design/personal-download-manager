{
  "manifest_version": 3,
  "name": "Personal Download Manager (PDM)",
  "version": "1.2.0",
  "key": "",
  "description": "High-performance download manager with dynamic video player grabber and multi-connection engine.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Personal Download Manager (PDM)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "webRequest",
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["floating.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
